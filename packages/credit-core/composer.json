{
    "name": "credit/core",
    "description": "Domaine métier du comparateur de crédit : enums, catalogue des partenaires, scoring, calcul de prêt et DTO",
    "type": "symfony-bundle",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-bcmath": "*",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/validator": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Credit\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Credit\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
