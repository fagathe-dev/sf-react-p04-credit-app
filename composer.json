{
    "name": "credit/platform",
    "description": "Outils d'analyse statique du monorepo (PHPStan, PHP-CS-Fixer) pour credit-core, credit_api et credit_front",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "phpstan": [
            "phpstan analyse -c phpstan.dist.neon --memory-limit=1G",
            "phpstan analyse -c phpstan.front.neon --memory-limit=1G"
        ],
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
