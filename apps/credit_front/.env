# Variables d'environnement de credit_front : versionnées, sans aucun secret.
# Les valeurs réelles et les secrets se définissent dans .env.local (jamais versionné).
# credit_front n'a ni base de données, ni mailer, ni JWT : aucune de ces variables n'y figure.

###> symfony/framework-bundle ###
APP_ENV=dev
# Secret : à définir dans .env.local
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# URI de l'application pour les URL générées hors requête HTTP
DEFAULT_URI=http://localhost:8001

###> site vitrine ###
# URL de credit_tunnel : base des boutons d'appel à l'action (TunnelLinkBuilder)
TUNNEL_URL=http://localhost:5172
APP_NAME="Comparateur de crédit"
# Design-system (sf-p05-design-system) : ds-icons.css, ds-ui-kit.css et js/main.js chargés par base.html.twig
DESIGN_SYSTEM_URL=
###< site vitrine ###
