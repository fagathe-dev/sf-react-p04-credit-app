# Variables d'environnement de credit_api : versionnées, sans aucun secret.
# Les valeurs réelles et les secrets se définissent dans .env.local (jamais versionné).
#
# Ordre de chargement : .env < .env.local < .env.$APP_ENV < .env.$APP_ENV.local.
# Les variables d'environnement réelles du serveur l'emportent sur tous les fichiers.

###> symfony/framework-bundle ###
APP_ENV=dev
# Secret : à définir dans .env.local
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# URI publique de credit_api (URL hors requête HTTP, URL absolue des logos)
DEFAULT_URI=http://localhost:8000

###> doctrine/doctrine-bundle ###
# Secret : DSN complet à définir dans .env.local
# Moteur retenu par les migrations : MySQL 8 / MariaDB, ex. mysql://user:pass@127.0.0.1:3306/credit?serverVersion=8.0.32&charset=utf8mb4
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Secret : à définir dans .env.local (null://null pour ne rien envoyer)
MAILER_DSN=
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
# Chemins seulement : les fichiers .pem ne sont jamais versionnés (bin/setup.sh les génère)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Secret : à définir dans .env.local
JWT_PASSPHRASE=
# Durée de la session en secondes
JWT_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> session et cookies ###
# Drapeau Secure du cookie : false en local HTTP, true en production
AUTH_COOKIE_SECURE=false
# Domaine parent partagé par les 3 apps React et l'API ; vide en local (localhost, ports différents)
AUTH_COOKIE_DOMAIN=
# Origines autorisées avec cookies (credit_tunnel, credit_client, credit_crm), séparées par des virgules
CORS_ALLOW_ORIGIN=http://localhost:5173
###< session et cookies ###

###> code OTP ###
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_DELAY_SECONDS=60
###< code OTP ###

###> fagathe-dev/core-php (e-mails) ###
# Base des liens envoyés par e-mail aux clients : URL de credit_client
FRONTEND_URL=http://localhost:5171
APP_NAME="Comparateur de crédit"
DEFAULT_EMAIL_SENDER=no-reply@localhost
SUPPORT_EMAIL=support@localhost
# Logo des e-mails, relatif à DEFAULT_URI (fichier public/assets/logo.svg)
LOGO_PATH=assets/logo.svg
###< fagathe-dev/core-php ###

###> back-office ###
# URL de credit_crm, base des liens des e-mails envoyés aux conseillers
CRM_URL=http://localhost:5170
###< back-office ###
